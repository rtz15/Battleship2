          "description": "Open the page /en/battleship."
        },
        {
          "id": "7c30550c-b6e9-4c3b-8a22-111331001002",
          "comment": "Use a stable desktop window size.",
          "command": "setWindowSize",
          "target": "1440x1000",
          "targets": [],
          "value": "",
          "description": "Resize the browser window to 1440x1000."
        },
        {
          "id": "7c30550c-b6e9-4c3b-8a22-111331001003",
          "comment": "Close the consent dialog if it is displayed.",
          "command": "runScript",
          "target": "const reject = Array.from(document.querySelectorAll('button')).find(button => button.textContent.includes('Do not consent')); if (reject) reject.click();",
          "targets": [],
          "value": "",
          "description": "Execute support JavaScript for the current page state."
        },
        {
          "id": "7c30550c-b6e9-4c3b-8a22-111331001004",
          "comment": "Validate that the shared game option is visible.",
          "command": "assertElementPresent",
          "target": "xpath=//button[contains(normalize-space(.),'Play with a friend') or contains(normalize-space(.),'Play with friend') or contains(normalize-space(.),'Invite a friend')]",
          "targets": [],
