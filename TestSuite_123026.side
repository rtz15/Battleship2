      "id": "7c30550c-b6e9-4c3b-8a22-123026001001",
      "comment": "Open the Battleship landing page.",
      "command": "open",
      "target": "/en/battleship",
      "targets": [],
      "value": ""
    }, {
      "id": "7c30550c-b6e9-4c3b-8a22-123026001002",
      "comment": "Use a stable desktop window size.",
      "command": "setWindowSize",
      "target": "1440x1000",
      "targets": [],
      "value": ""
    }, {
      "id": "7c30550c-b6e9-4c3b-8a22-123026001003",
      "comment": "Close the consent dialog if it is displayed.",
      "command": "runScript",
      "target": "const reject = Array.from(document.querySelectorAll('button')).find(button => button.textContent.includes('Do not consent')); if (reject) reject.click();",
      "targets": [],
      "value": ""
    }, {
      "id": "7c30550c-b6e9-4c3b-8a22-123026001004",
      "comment": "Validate that the daily leaderboard section is visible.",
      "command": "assertElementPresent",
      "target": "xpath=//*[contains(normalize-space(.),'Daily leaderboard')]",
      "targets": [],
      "value": ""
    }, {
      "id": "7c30550c-b6e9-4c3b-8a22-123026001005",
      "comment": "Validate that the ranking area is visible.",
      "command": "assertElementPresent",
      "target": "xpath=//*[contains(normalize-space(.),'RANKA')]",
      "targets": [],
      "value": ""
    }, {
      "id": "7c30550c-b6e9-4c3b-8a22-123026001006",
      "comment": "Validate that the general ranking description is visible.",
      "command": "assertElementPresent",
      "target": "xpath=//*[contains(normalize-space(.),'General ranking since 30 days.')]",
      "targets": [],
      "value": ""
    }]
