    {
      "id": "1a84e5c4-8a58-4ab9-81a8-110894000101",
      "name": "UserStoryTest1",
      "commands": [
        {
          "id": "1a84e5c4-8a58-4ab9-81a8-110894001001",
          "comment": "Open the Battleship landing page.",
          "command": "open",
          "target": "/en/battleship",
          "targets": [],
          "value": "",
          "description": "Open the page /en/battleship."
        },
        {
          "id": "1a84e5c4-8a58-4ab9-81a8-110894001002",
          "comment": "Use a stable desktop window size.",
          "command": "setWindowSize",
          "target": "1440x1000",
          "targets": [],
          "value": "",
          "description": "Resize the browser window to 1440x1000."
        },
        {
          "id": "1a84e5c4-8a58-4ab9-81a8-110894001003",
          "comment": "Close the consent dialog if it is displayed.",
          "command": "runScript",
          "target": "const reject = Array.from(document.querySelectorAll('button')).find(button => button.textContent.includes('Do not consent')); if (reject) reject.click();",
          "targets": [],
          "value": "",
          "description": "Execute support JavaScript for the current page state."
        },
        {
          "id": "1a84e5c4-8a58-4ab9-81a8-110894001004",
          "comment": "Validate that the Battleship page title is visible.",
          "command": "assertElementPresent",
          "target": "xpath=//*[contains(normalize-space(.),'Battleship Online')]",
          "targets": [],
          "value": "",
          "description": "Check that the expected element is present: xpath=//*[contains(normalize-space(.),'Battleship Online')]."
        },
        {
